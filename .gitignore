# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# local database files
*.sqlite
*.sqlite3
*.db
# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/.nyc_output/
/playwright-report/
/test-results/

# next.js
/.next/
/.vinext/
/out/

# misc
.DS_Store
Thumbs.db
Desktop.ini
*.pem
*.tmp
*.temp
*.swp
*.swo
*~

# editor settings
/.idea/
/.vscode/

# tool caches
/.cache/
/.turbo/
.eslintcache
.stylelintcache

# debug
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example
!.env.sample
.dev.vars*
!.dev.vars.example

# vercel
.vercel

# typescript
next-env.d.ts
*.tsbuildinfo

# Maintained Vite plugin and worker sources.
!/build/
/build/*
!/build/connector-preview-plugin.mjs
!/build/connector-preview-worker.mjs
!/build/sites-vite-plugin.LICENSE
!/build/sites-vite-plugin.ts
!/build/sites-worker.ts

/dist/
/.wrangler/
# Checkout-local execution profile and tool state; never publish them.
/.sites-runtime/
/.agents/
/.codex/
/outputs/
/work/

# local deployment archives
*.tar.gz
*.tgz
